# 環境變量字段模板（不含密鑰）。複製為 .env.local 後填入真實值。
# 加載順序：進程環境變量 > .env.server.local > .env.local > .env
# 已存在的進程環境變量不會被文件覆蓋。

# 必填。Google Gemini API Key，由部署方提供。
GEMINI_API_KEY=

# 可選。本地開發建議 9002。未設置時 server.ts 默認監聽 3000（AI Studio）。
PORT=9002

# 可選模型覆蓋。未設置時使用代碼內默認值。
# GEMINI_MODEL=
# GEMINI_FAST_MODEL=
# GEMINI_VISION_MODEL=
# GEMINI_TRANSCRIBE_MODEL=

# 可選。受限網絡下的中轉 / 反代 Base URL。
# GEMINI_BASE_URL=

# 可選，僅 Cloudflare Workers 形態使用（Node 端 server.ts 不讀取）。默認值在 wrangler.jsonc 的 vars；
# 本地 `npm run cf:dev` 會讀取 .env.local，可在此把數據上報回源地址指向本地服務，例如 http://127.0.0.1:8002。
# UPLOAD_ORIGIN=
