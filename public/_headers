# Consolidation (perf): repeat visits. Vite chunks are content-hashed, so a
# changed file always has a new name — safe to keep for a year. Art and icons
# change rarely and are renamed when they do. HTML and /styles/* (not hashed)
# keep the platform default (revalidate every load).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
